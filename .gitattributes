# Git 怎么对待不同的文件。新电脑上要先装 Git LFS（brew install git-lfs），见 AGENTS.md。
# 参考：NYUGameCenter/Unity-Git-Config、github/gitignore 的 Unity 模板

# 换行统一
* text=auto

# Unity 的文本资源（场景、预制体、材质……）：冲突时交给 Unity 自带的 UnityYAMLMerge 合并
[attr]unityyaml -text merge=unityyamlmerge diff
*.unity       unityyaml
*.prefab      unityyaml
*.asset       unityyaml
*.meta        unityyaml
*.mat         unityyaml
*.anim        unityyaml
*.controller  unityyaml
*.overrideController unityyaml
*.physicMaterial unityyaml
*.physicsMaterial2D unityyaml
*.playable    unityyaml
*.mask        unityyaml
*.brush       unityyaml
*.flare       unityyaml
*.fontsettings unityyaml
*.guiskin     unityyaml
*.giparams    unityyaml
*.renderTexture unityyaml
*.spriteatlas unityyaml
*.terrainlayer unityyaml
*.lighting    unityyaml
*.shadervariants unityyaml
*.signal      unityyaml

# 代码
*.cs   text diff=csharp
*.lua  text
*.shader text
*.hlsl text
*.json text
*.md   text

# 大文件走 Git LFS：仓库里只存指针，真身放 LFS
[attr]lfs filter=lfs diff=lfs merge=lfs -text
# 图片
*.png lfs
*.jpg lfs
*.jpeg lfs
*.psd lfs
*.tga lfs
*.tif lfs
*.tiff lfs
*.exr lfs
*.hdr lfs
*.gif lfs
*.bmp lfs
*.webp lfs
# 模型和动画
*.fbx lfs
*.FBX lfs
*.obj lfs
*.blend lfs
*.gltf lfs
*.glb lfs
*.dae lfs
*.3ds lfs
# 声音和视频
*.wav lfs
*.mp3 lfs
*.ogg lfs
*.aif lfs
*.aiff lfs
*.mp4 lfs
*.mov lfs
*.webm lfs
# 字体
*.ttf lfs
*.otf lfs
# 其他二进制
*.zip lfs
*.7z lfs
*.dll lfs
*.so lfs
*.a lfs
*.bundle lfs
*.cubemap lfs
*.unitypackage lfs
